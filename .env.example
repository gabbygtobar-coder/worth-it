# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase dashboard > Project Settings > API). Never commit .env.local.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key. Safe to expose in the browser: every table is protected by
# Row Level Security, so this key can only read and write the signed-in user's rows.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Origin used to build auth redirect links. Use http://localhost:3000 locally
# and the deployed origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
